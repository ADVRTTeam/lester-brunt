# -----------------------------------------------------------------------------
# Enquiry endpoint configuration
#
# Set these in Netlify: Site configuration > Environment variables.
# Every one is optional. With none set, the form still works and every lead is
# written to the function log — nothing is lost, it just isn't forwarded.
# -----------------------------------------------------------------------------

# Where leads are sent. Any endpoint that accepts a JSON POST:
# a CRM, Zapier/Make catch hook, HighLevel inbound webhook, your own API.
LEAD_WEBHOOK_URL=

# Optional second destination, posted at the same time as the first.
LEAD_WEBHOOK_URL_2=

# If set, each delivery is signed so the receiver can prove it came from here:
#   X-LB-Timestamp: <unix seconds>
#   X-LB-Signature: sha256=<hex HMAC-SHA256 of "<timestamp>.<raw body>">
LEAD_WEBHOOK_SECRET=

# Optional Slack Incoming Webhook. Posts a one-line alert for every lead.
SLACK_WEBHOOK_URL=

# Lowest pension band counted as qualified. Leads below it are scored tier D.
# One of: UNDER_100K | 100K_250K | 250K_500K | 500K_1M | OVER_1M
# (The board left this as [AWAITING MARKETING PLUS] — set it once agreed.)
LEAD_VALUE_FLOOR=UNDER_100K

# Where a non-JavaScript form post is sent after a successful submission.
THANK_YOU_PATH=/thank-you/
